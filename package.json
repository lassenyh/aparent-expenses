    "pdf-lib": "^1.17.1",
    "pg": "^8.19.0",
    "puppeteer": "^25.11.0",
    "puppeteer-core": "^25.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/heic-convert": "^2.1.1",
