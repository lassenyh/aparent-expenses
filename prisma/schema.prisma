// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  DRAFT
  REVIEW
  SUBMITTED
}

model Submission {
  id                  String           @id @default(cuid())
  accessToken         String           @unique
  createdAt           DateTime         @default(now())
  status              SubmissionStatus @default(DRAFT)
  name                String?
  projectNumber       String?
  project             String?
  workDate            DateTime?
  productionCash      Int?
  accountNumber       String?
  totalInclVat        Int?
  combinedPdfUrl      String?
  version             Int              @default(0)
  recipientEmail      String?
  adminFlow           Boolean          @default(false)
  expiresAt           DateTime?
  productionCashCents Int?
  deliveryStatus      String           @default("NOT_SENT")
  deliveryError       String?
  deliveryId          String?
  deliveryStartedAt   DateTime?
  submissionStartedAt DateTime?
  receipts            Receipt[]
}

model Receipt {
  id                    String            @id @default(cuid())
  submissionId          String
  submission            Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalFileName      String
  mimeType              String
  sizeBytes             Int
  blobUrl               String
  blobPath              String
  createdAt             DateTime          @default(now())
  extractedSummary      String?
  extractedTotalCents   Int?
  extractedCurrency     String?           @default("NOK")
  originalAmountCents   Int? // amount in original currency (for display when different from NOK)
  analysisStatus        String            @default("PENDING")
  analysisError         String?
  analysisStartedAt     DateTime?
  merchant              String?
  receiptDate           String?
  vatBreakdown          Json?
  lineItems             Json?
  reviewed              Boolean           @default(false)
  contentHash           String?
  sourcePages           Int[]             @default([])
  generations           ReceiptAnalysis[]
  comment               String?
  commentFlags          String? // JSON array e.g. ["MEAL","TRANSPORT"]
  dismissedCommentFlags String? // JSON array e.g. ["TRANSPORT"]

  @@index([submissionId, createdAt])
  @@index([analysisStatus, analysisStartedAt])
}

model ReceiptAnalysis {
  id            String    @id @default(cuid())
  receiptId     String
  receipt       Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  model         String
  promptVersion String
  status        String    @default("RUNNING")
  result        Json?
  error         String?
  durationMs    Int?
  inputTokens   Int?
  outputTokens  Int?

  @@index([receiptId, createdAt])
}

model CleanupJob {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  provider    String
  target      String
  attempts    Int       @default(0)
  lastError   String?
  completedAt DateTime?

  @@unique([provider, target])
  @@index([completedAt, createdAt])
}

model EmailOutbox {
  id             String    @id
  submissionId   String    @unique
  createdAt      DateTime  @default(now())
  firstAttemptAt DateTime?
  leaseUntil     DateTime?
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  payload        Json
  lastError      String?
  providerId     String?

  @@index([status, leaseUntil])
}

model ReceiptSource {
  id               String   @id @default(cuid())
  submissionId     String
  blobUrl          String
  blobPath         String
  originalFileName String
  mimeType         String
  createdAt        DateTime @default(now())

  @@unique([submissionId, blobUrl])
}
